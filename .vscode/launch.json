        {
            "name": "Example.React (Vite)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "node",
            "runtimeArgs": ["--max-http-header-size=65536"],
            "program": "${workspaceFolder}/InHouseOidc.Example.React/node_modules/vite/bin/vite.js",
            "cwd": "${workspaceFolder}/InHouseOidc.Example.React",
            "console": "integratedTerminal",
            "serverReadyAction": {
                "pattern": "Local:.*http://localhost:([0-9]+)",
                "uriFormat": "http://localhost:%s",
                "action": "openExternally"
            }
        }
    ],
    "compounds": [
        {
            "name": "Example.React (standalone)",
            "configurations": [
                "Example.React (Vite)"
            ],
            "preLaunchTask": "start: React dependencies",
            "stopAll": true
        },
        {
            "name": "All Examples",
            "configurations": [
                "Example.Provider",
                "Example.Api",
                "Example.Razor",
                "Example.Mvc",
                "Example.Bff",
                "Example.CredentialsClient",
